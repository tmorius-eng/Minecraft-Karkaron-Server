# Build output
build/
.gradle/
out/

# Gradle
!gradle/wrapper/gradle-wrapper.jar

# Paper test server (run-paper default dir and our script's dir)
run/
server/
*.jar.tmp

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
bin/

# Asset-pipeline toolchain (regenerated by scripts/setup-cloud-tools.sh)
.tools/
# Meshy task metadata cache (safe to regenerate; contains no secrets)
assets/.meshy_cache/
# Large raw source meshes (Meshy/Blender) live here, NEVER in resourcepack/.
# Kept out of git (regenerable, large). Canonical dir is assets/source/.
assets/source/*.glb
assets/source/*.fbx
assets/source/*.obj
assets/source/*.blend
assets/sources/*.glb
assets/sources/*.fbx
assets/sources/*.obj

# OS
.DS_Store

# Real deployment config (contains the DB password) — only the .example is tracked
deploy/*.env
__pycache__/
