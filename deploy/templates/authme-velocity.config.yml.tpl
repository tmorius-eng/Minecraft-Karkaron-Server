# Generated by SULD deploy.sh (AUTH_MODE=hybrid) on every deploy: edit deploy/templates/authme-velocity.config.yml.tpl.
# Keys as AuthMe Velocity 6.0.1 writes them (docs/qa/2026-10-18-authme-spike.md, S1).
authServers:
- suld
allServersAreAuthServers: false
serverSwitch:
    requiresAuth: true
    kickMessage: Нэвтрээгүй байна. / Authentication required.
autoLogin: false
sendOnLogout: false
unloggedUserServer: ''
commands:
    requireAuth: true
    whitelist:
    - /login
    - /register
    - /l
    - /reg
    - /email
    - /captcha
    - /2fa
    - /totp
    - /log
chatRequiresAuth: true
loginServer: ''
# Must equal Hooks.proxySharedSecret in the backend's plugins/AuthMe/config.yml (AUTHME_PROXY_SECRET in suld.env).
proxySharedSecret: '@AUTHME_PROXY_SECRET@'
premium:
    # Every account keeps the offline UUID of its name: one identity rule for premium and offline players
    # (docs/AUTHENTICATION.md). A premium player who renames is a new character.
    keepOfflineUuidCompatibility: true
