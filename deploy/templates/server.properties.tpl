# Generated by SULD deploy.sh on first install; edit freely afterwards (never overwritten).
# AUTH_MODE=hybrid: Paper listens on loopback only, behind the Velocity proxy (deploy.sh keeps these four in step).
server-ip=@BACKEND_IP@
server-port=@BACKEND_PORT@
motd=@MOTD@
max-players=@MAX_PLAYERS@
online-mode=@ONLINE_MODE@
# SULD ships its own hardcore/death system; vanilla hardcore stays off.
hardcore=false
difficulty=hard
pvp=true
spawn-protection=0
view-distance=6
simulation-distance=4
enable-command-block=false
enable-rcon=false
enable-query=false
white-list=false
enforce-secure-profile=@ENFORCE_SECURE_PROFILE@
network-compression-threshold=256
sync-chunk-writes=true
