# SÜLD deployment configuration.
#
# deploy.sh copies this file to /etc/suld/suld.env (root:suld, mode 640) the first time it
# runs, generates DB_PASS, then stops so you can review it. Re-run deploy.sh afterwards.
# All scripts `source` this file as shell: quote any value that contains spaces.
# NEVER commit the real /etc/suld/suld.env — it contains the database password.

# --- Identity / layout ---
SULD_USER=suld
SULD_HOME=/opt/suld
SERVER_DIR=/opt/suld/server
REPO_DIR=/opt/suld/repo
PACK_DIR=/opt/suld/pack
BACKUP_DIR=/opt/suld/backups
# Off-host copy of every backup (strongly recommended): user@host:/path (rsync over ssh) or rclone:<remote>:<path>.
BACKUP_REMOTE=

# --- Source ---
REPO_URL=https://github.com/tmorius-eng/Minecraft-Karkaron-Server.git
REPO_BRANCH=main

# --- Platform versions ---
MC_VERSION=1.21.11          # Paper/Minecraft version (Java 21 required)
JAVA_PACKAGE=openjdk-21-jdk-headless

# --- JVM memory (tune to the VPS; leave headroom for the OS) ---
JVM_MIN=2G
JVM_MAX=4G

# --- Networking ---
SERVER_PORT=25565           # Minecraft
PACK_PORT=8080              # static resource-pack HTTP host
BEDROCK_PORT=               # blank = Java Edition only (default). Set 19132 only together with the optional Geyser profile; must match bedrock.port in plugins/Geyser-Spigot/config.yml
PUBLIC_HOST=                # public IP/host for the pack URL; blank = auto-detect

# --- Database (PostgreSQL, local by default) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=suld
DB_USER=suld
DB_PASS=                    # generated by deploy.sh if blank

# --- Server identity ---
MOTD="SÜLD - Mongolian Hardcore MMORPG"
MAX_PLAYERS=25              # what the last load test holds (docs/perf/M3_2026-10-12.md); raise after a run on this host
ONLINE_MODE=true            # AUTH_MODE=online: MUST be true (deploy.sh refuses false). AUTH_MODE=hybrid sets Paper's to false

# --- Accounts (docs/AUTHENTICATION.md) ---
# online = only Microsoft (premium) accounts, Paper checks every login (default).
# hybrid = premium AND offline accounts, Java Edition only: a Velocity proxy takes SERVER_PORT, Paper moves to
#          127.0.0.1:PAPER_PORT (never opened), AuthMe on both: premium players are checked with Mojang (after they
#          opt in with /premium confirm), everyone else has a password. Every account keeps the offline UUID of its
#          name: a premium player who renames is a new character. Switching an existing server needs
#          docs/operations/HYBRID_CUTOVER.md first.
AUTH_MODE=online
PAPER_PORT=25566            # hybrid: Paper's loopback port behind the proxy
VELOCITY_VERSION=3.5.1      # hybrid: newest build of this Velocity version, sha256-checked
PROXY_DIR=/opt/suld/proxy
PROXY_JVM_MAX=512M
TMUX_PROXY_SESSION=suld-proxy
# hybrid secrets: generated by deploy.sh when blank, never printed. The first is Velocity's forwarding secret (Paper
# trusts only it), the second signs AuthMe's proxy -> backend login messages.
VELOCITY_FORWARDING_SECRET=
AUTHME_PROXY_SECRET=

# --- Alerts ---
# A Discord webhook (Server settings → Integrations → Webhooks) or any URL that accepts {"content": "..."} JSON.
# The health timer (every 10 min), a failed or crash-looping unit and a failed backup post there. Blank = no alerts.
# Keep it secret like a password: whoever has it can post to that channel. It is never logged.
ALERT_WEBHOOK_URL=
# The weekly funnel report (Monday 09:10 Улаанбаатар, suld-funnel.timer, docs/ANALYTICS.md) posts its summary here.
# Blank = the alert webhook above; both blank = only the Markdown file under /opt/suld/run/reports.
REPORT_WEBHOOK_URL=

# --- Discord ---
# The public channel's webhook (docs/DISCORD.md): the game posts chronicle firsts, the world boss call and rise,
# Их Хуралдай's opening and result and the server going up or down. /report lines go to ALERT_WEBHOOK_URL (staff).
# Blank = nothing is posted. A secret like a password; deploy.sh writes it into the plugin's config.yml (mode 600).
DISCORD_WEBHOOK_URL=

# --- Admins ---
# Space-separated Minecraft names made server operator after the first successful boot
# (deploy.sh). Empty by default (SEC-002): put YOUR account here, or later: sudo /opt/suld/bin/op.sh <name>
ADMIN_PLAYERS=""

# --- Legal / build options ---
# You must accept the Minecraft EULA (https://aka.ms/MinecraftEULA) yourself: set to true.
ACCEPT_EULA=false
# Optional: install this prebuilt plugin jar instead of building on the server
# (e.g. build on your laptop: ./gradlew :suld-plugin:shadowJar, scp it, set the path here).
PLUGIN_JAR=
# true = skip the unit tests when updating (faster, less safe). Default runs the full build.
SKIP_TESTS=false
HEALTH_MIN_DISK_MB=2048     # health-check warns below this much free disk

# --- Payments (Bonum, docs/PAYMENT_ARCHITECTURE.md) ---
# The merchant's secrets for the credit store. Blank = the gateway stays off (payment.bonum.enabled must be true too).
# Never commit real values; this file lives in /etc/suld/suld.env (root:suld, mode 640) and is never logged.
BONUM_TERMINAL_ID=
BONUM_APP_SECRET=
BONUM_CHECKSUM_KEY=

# --- Control ---
TMUX_SESSION=suld
BACKUP_KEEP=14              # how many timestamped backups to retain
# Aikar's GC flags for a smooth, low-pause Minecraft server.
AIKAR_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"

# Third-party plugins from deploy/plugins/plugins.json: core,hardening (default) | core | none
PLUGIN_PROFILES="core,hardening"
