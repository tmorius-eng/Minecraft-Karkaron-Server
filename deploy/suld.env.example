# SÜLD deployment configuration.
#
# deploy.sh copies this file to /etc/suld/suld.env (root:suld, mode 640) the first time it
# runs, generates DB_PASS, then stops so you can review it. Re-run deploy.sh afterwards.
# All scripts `source` this file as shell: quote any value that contains spaces.
# NEVER commit the real /etc/suld/suld.env — it contains the database password.

# --- Identity / layout ---
SULD_USER=suld
SULD_HOME=/opt/suld
SERVER_DIR=/opt/suld/server
REPO_DIR=/opt/suld/repo
PACK_DIR=/opt/suld/pack
BACKUP_DIR=/opt/suld/backups

# --- Source ---
REPO_URL=https://github.com/tmorius-eng/Minecraft-Karkaron-Server.git
REPO_BRANCH=main

# --- Platform versions ---
MC_VERSION=1.21.11          # Paper/Minecraft version (Java 21 required)
JAVA_PACKAGE=openjdk-21-jdk-headless

# --- JVM memory (tune to the VPS; leave headroom for the OS) ---
JVM_MIN=2G
JVM_MAX=4G

# --- Networking ---
SERVER_PORT=25565           # Minecraft
PACK_PORT=8080              # static resource-pack HTTP host
PUBLIC_HOST=                # public IP/host for the pack URL; blank = auto-detect

# --- Database (PostgreSQL, local by default) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=suld
DB_USER=suld
DB_PASS=                    # generated by deploy.sh if blank

# --- Server identity ---
MOTD="SÜLD - Mongolian Hardcore MMORPG"
MAX_PLAYERS=50
ONLINE_MODE=true            # MUST be true: identity = Minecraft/Microsoft auth (deploy.sh refuses false)

# --- Admins ---
# Space-separated Minecraft names made server operator after the first successful boot
# (deploy.sh). Later: sudo /opt/suld/bin/op.sh <name>
ADMIN_PLAYERS="qeevr_"

# --- Legal / build options ---
# You must accept the Minecraft EULA (https://aka.ms/MinecraftEULA) yourself: set to true.
ACCEPT_EULA=false
# Optional: install this prebuilt plugin jar instead of building on the server
# (e.g. build on your laptop: ./gradlew :suld-plugin:shadowJar, scp it, set the path here).
PLUGIN_JAR=
# true = skip the unit tests when updating (faster, less safe). Default runs the full build.
SKIP_TESTS=false
HEALTH_MIN_DISK_MB=2048     # health-check warns below this much free disk

# --- Control ---
TMUX_SESSION=suld
BACKUP_KEEP=14              # how many timestamped backups to retain
# Aikar's GC flags for a smooth, low-pause Minecraft server.
AIKAR_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"

# Third-party plugins from deploy/plugins/plugins.json: core,hardening (default) | core | none
PLUGIN_PROFILES="core,hardening"
